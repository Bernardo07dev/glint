generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
}

model User {
  id                  String         @id @default(uuid())
  name                String
  email               String         @unique
  emailVerifiedAt     DateTime?
  passwordHash        String?
  avatarUrl           String?
  plan                Plan           @default(FREE)
  planExpiresAt       DateTime?
  billingCustomerId   String?
  timezone            String         @default("America/Sao_Paulo")
  knowledgeGraph      String?
  planCreationPrompts Json?
  onboardingCompleted Boolean        @default(false)
  lastActiveAt        DateTime?
  learningPlans       LearningPlan[]
  animation           UserAnimation?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model UserAnimation {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstAccess      String?
  waitingFrontTap  String?
  homeSplashReady  String?
  homeSplashStreak String?
  homeSplashReturn String?
  homeSplashRest   String?
  planCreation     String?
  plansHub         String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum PlanStage {
  REFINING_GOAL
  INTERVIEWING_STEPS
  GENERATING_TASKS
  ENRICHING_TASKS
  ACTIVE
  COMPLETED
}

enum MessageRole {
  USER
  ASSISTANT
}

model LearningPlan {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  isFirstPlan    Boolean       @default(false)
  complete       Boolean       @default(false)
  stage          PlanStage     @default(REFINING_GOAL)
  rawInput       String
  refinedGoal    String?
  executableMeta Json?
  planStructure  Json?
  currentStepId  String?
  totalTasks     Int           @default(0)
  completedTasks Int           @default(0)
  messages       PlanMessage[]
  tasks          PlanTask[]
  replans        PlanReplan[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, stage])
}

enum TaskEnrichmentStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum TaskStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

model PlanTask {
  id                String               @id @default(uuid())
  planId            String
  plan              LearningPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  taskKey           String
  order             Int

  title             String
  whyItMatters      String
  taskType          String
  requiredTools     String[]
  searchQueryUsed   String

  scheduledDate     String
  dayOfWeek         String
  startTime         String
  durationMinutes   Int
  consumeMinutes    Int
  practiceMinutes   Int
  unlockAt          DateTime
  triggerAt         DateTime

  enrichmentStatus  TaskEnrichmentStatus @default(PENDING)
  triggerRunId      String?
  jevAlignmentScore Float?
  enrichedAt        DateTime?

  stepsPlan         Json?
  content           Json?

  status            TaskStatus             @default(LOCKED)
  currentStepId     String?
  completedSteps    String[]               @default([])
  completedAt       DateTime?
  difficultyRating  String?
  userNotes         String?
  stepProgress      PlanTaskStepProgress[]

  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([planId, order])
  @@index([planId, scheduledDate])
  @@index([planId, status])
  @@index([triggerAt])
}

enum StepProgressStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model PlanTaskStepProgress {
  id                  String             @id @default(uuid())
  taskId              String
  task                PlanTask           @relation(fields: [taskId], references: [id], onDelete: Cascade)

  stepId              String
  order               Int
  phase               String
  toolType            String
  title               String
  estimatedMinutes    Int

  status              StepProgressStatus @default(PENDING)

  totalChecklistItems Int                @default(0)
  checkedItems        Int[]              @default([])

  timeSpentSeconds    Int                @default(0)
  startedAt           DateTime?
  completedAt         DateTime?
  lastInteractionAt   DateTime?

  quizData            Json?

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([taskId, stepId])
  @@index([taskId, order])
  @@index([taskId, status])
}

model PlanMessage {
  id        String       @id @default(uuid())
  planId    String
  plan      LearningPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  role      MessageRole
  stage     PlanStage
  stepId    String?
  content   String
  createdAt DateTime     @default(now())

  @@index([planId, stage, stepId, createdAt])
}

enum ReplanStrategy {
  SCHEDULE_ONLY
  PARTIAL_REPLAN
  GOAL_PIVOT
}

model PlanReplan {
  id            String         @id @default(uuid())
  planId        String
  plan          LearningPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  version       Int
  strategy      ReplanStrategy
  reasonSummary String
  oldPlan       Json
  newPlan       Json
  createdAt     DateTime       @default(now())

  @@unique([planId, version])
  @@index([planId, createdAt])
}
